#!/bin/sh

# Git invokes post-checkout with old HEAD, new HEAD, and a flag indicating
# whether the checkout updated the branch (1) or individual paths (0).
case "${3:-0}" in
  1) ;;
  *) exit 0 ;;
esac

current_worktree="$(git rev-parse --show-toplevel 2>/dev/null)" || exit 0
primary_worktree="$(
  git worktree list --porcelain 2>/dev/null |
    awk '$1 == "worktree" { print substr($0, 10); exit }'
)"

[ -n "$primary_worktree" ] || exit 0

source_env="$primary_worktree/test.env"
destination_env="$current_worktree/test.env"

# The hook only copies from the primary worktree into another worktree. Keep
# symlinks out of the flow so a private file cannot redirect the copy.
[ "$source_env" != "$destination_env" ] || exit 0
[ -f "$source_env" ] || exit 0
[ ! -L "$source_env" ] || exit 0
[ ! -e "$destination_env" ] || exit 0
[ ! -L "$destination_env" ] || exit 0

umask 077
if ! cp "$source_env" "$destination_env" 2>/dev/null; then
  printf '%s\n' "OpenMergeLens: could not copy test.env into $current_worktree" >&2
  exit 0
fi

if ! chmod 600 "$destination_env" 2>/dev/null; then
  rm -f "$destination_env"
  printf '%s\n' "OpenMergeLens: could not secure copied test.env in $current_worktree" >&2
  exit 0
fi

printf '%s\n' "OpenMergeLens: copied test.env into $current_worktree"
