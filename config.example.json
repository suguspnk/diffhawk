{
  "githubAccount": {
    "hostname": "github.com",
    "username": "your-github-username"
  },
  "searchScope": "per-repo",
  "pollTargets": [
    {
      "repo": "OWNER/REPO",
      "reviewPromptPath": "./docs/review-prompts/OWNER/REPO.md",
      "learningsPath": "./docs/learnings.md"
    }
  ],
  "reviewerCommand": "claude -p --output-format text",
  "reviewerInputMode": "stdin",
  "reviewBatchSize": 5,
  "stateFile": "./state.json"
}
