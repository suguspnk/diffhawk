{
  "configVersion": 2,
  "githubAccounts": [
    {
      "hostname": "github.com",
      "username": "work-account",
      "repositories": [
        "COMPANY/API",
        "COMPANY/WEB"
      ],
      "aiProcessingConsent": [
        "COMPANY/API",
        "COMPANY/WEB"
      ]
    },
    {
      "hostname": "github.com",
      "username": "personal-account",
      "repositories": [
        "OWNER/PROJECT"
      ],
      "aiProcessingConsent": [
        "OWNER/PROJECT"
      ]
    }
  ],
  "reviewerCommand": "claude -p --output-format text --setting-sources \"\" --strict-mcp-config --permission-mode dontAsk --max-turns 100 --tools \"\"",
  "reviewerInputMode": "stdin",
