+                fputs("alerter: \(error.localizedDescription)\n", stderr)
+                exit(EXIT_FAILURE)
+            }
+            guard granted else {
+                fputs("alerter: notification permission was denied\n", stderr)
+                exit(EXIT_FAILURE)
+            }
+
+            let content = UNMutableNotificationContent()
