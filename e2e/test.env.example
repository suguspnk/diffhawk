# Copy this file to e2e/test.env and edit the values before running the live
# review test. The real GitHub token is intentionally not stored here; the
# harness resolves it from the matching `gh` account.

OPENMERGELENS_E2E_REPO='OWNER/REPO'
OPENMERGELENS_E2E_PR='123'
OPENMERGELENS_E2E_USERNAME='e2e-reviewer'

# Replace this with the exact generated command for the reviewer CLI you use.
# This is the generated Claude command from config.example.json.
OPENMERGELENS_E2E_REVIEWER_COMMAND='claude -p --output-format text --setting-sources "" --strict-mcp-config --permission-mode dontAsk --max-turns 100 --tools ""'

OPENMERGELENS_E2E_HOST='github.com'
OPENMERGELENS_E2E_MODE='dry-run'
OPENMERGELENS_E2E_REVIEW_FOCUS_COUNT='1'
OPENMERGELENS_E2E_REVIEW_TIMEOUT_MS='720000'

# Set to 1 only when you need to inspect the temporary config and poll.log.
OPENMERGELENS_E2E_KEEP_HOME='0'

# Post mode requires a fresh test commit and this exact explicit confirmation:
# OPENMERGELENS_E2E_MODE='post'
# OPENMERGELENS_E2E_POST_CONFIRM='I_UNDERSTAND_POSTING_TO_TEST_PR'
